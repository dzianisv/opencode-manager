{
  "name": "opencode-manager",
  "version": "0.8.25",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "postinstall": "if [ ! -d backend/dist ]; then tar -xzf backend-dist.tar.gz 2>/dev/null || true; fi && if [ ! -d frontend/dist ]; then tar -xzf frontend-dist.tar.gz 2>/dev/null || true; fi",
    "predev": "bash scripts/setup-dev.sh",
    "dev": "concurrently \"pnpm:dev:backend\" \"pnpm:dev:frontend\"",
    "dev:backend": "bun --watch backend/src/index.ts",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "typecheck": "pnpm run typecheck:frontend && pnpm run typecheck:backend",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "test": "pnpm run test:backend",
    "test:backend": "pnpm --filter backend test",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "pnpm --filter backend lint",
    "lint:fix": "pnpm run lint:frontend -- --fix && pnpm run lint:backend -- --fix",
    "generate:openapi": "bun scripts/generate-openapi.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "^1.57.0",
    "puppeteer": "^24.34.0",
    "tesseract.js": "^7.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@hono/node-ws": "^1.2.0",
    "@opencode-ai/sdk": "^1.1.36",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.2.3",
    "eventsource": "^4.1.0",
    "grammy": "^1.39.3",
    "hono": "^4.10.1",
    "node-cron": "^4.2.1",
    "node-pty": "^1.1.0",
    "socket.io": "^4.8.3",
    "strip-json-comments": "^3.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  }
}
